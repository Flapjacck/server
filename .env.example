TUNNEL_TOKEN=change-me

# Frontend API base URL — leave empty for same-origin nginx proxy (production default)
# Set to http://localhost:3000 when running the api separately in dev
VITE_API_BASE_URL=

# Judge API (event) — comma-separated keys; one per group recommended
JUDGE_API_KEYS=dev-key-change-me
JUDGE_RUNNER_IMAGE=ows-judge-runner:local
JUDGE_MAX_CONCURRENT=8
JUDGE_RUN_TIMEOUT_MS=8000
JUDGE_RATE_LIMIT_PER_MIN=20
