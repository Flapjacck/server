# Environment configuration (copy to .env.local for local development)

# Node environment
NODE_ENV=development

# Express API port (internal, not exposed directly)
PORT=3000

# API Keys (comma-separated) - generate with: openssl rand -hex 32
# For local development, use simple test keys
API_KEYS=dev-key-1,dev-key-2

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=debug

# CORS origin
CORS_ORIGIN=http://localhost

# Cloudflare Tunnel token (only needed for production)
# CLOUDFLARED_TOKEN=
