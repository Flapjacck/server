# Production environment (copy to .env.prod and fill in real values)
# NEVER commit .env.prod to git - it contains secrets!

# Node environment
NODE_ENV=production

# Express API port (internal, not exposed to public)
PORT=3000

# API Keys (comma-separated)
# Generate with: openssl rand -hex 32
# Example: a1b2c3d4...x1y2z3a4...
API_KEYS=REPLACE_WITH_PRODUCTION_KEYS

# Log level for production (use 'info' or 'warn' to reduce logging overhead)
LOG_LEVEL=info

# CORS origin - set to your actual domain
CORS_ORIGIN=https://yourdomain.com

# Cloudflare Tunnel token (required for production)
# Get from: cloudflared tunnel token my-api-tunnel
CLOUDFLARED_TOKEN=REPLACE_WITH_CLOUDFLARE_TOKEN
